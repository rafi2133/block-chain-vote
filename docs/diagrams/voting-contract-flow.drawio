        <UserObject id="config_note" label="Configuration: 2–20 candidates; metadataHash != 0;&lt;br&gt;startsAt &amp;gt; now; endsAt &amp;gt; startsAt.&lt;br&gt;Draft operations revert after publication." data-source="contracts/contracts/Voting.sol" data-role="note">
