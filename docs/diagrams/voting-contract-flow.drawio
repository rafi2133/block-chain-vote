  <diagram id="election-lifecycle" name="Election Lifecycle">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1950" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Voting Smart Contract — Election Lifecycle" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=38;fontStyle=1;fontColor=#203047;align=left;verticalAlign=middle;spacing=0;">
          <mxGeometry x="50" y="20" width="1890" height="65" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Preparation and publication on the left; independent state and result reads on the right / below" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#52677E;align=left;verticalAlign=middle;spacing=0;">
          <mxGeometry x="50" y="95" width="1890" height="35" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="01  Create → Configure → Publish" vertex="1" parent="1" style="swimlane;startSize=55;container=1;collapsible=0;pointerEvents=0;html=1;whiteSpace=wrap;fillColor=#F3F6FA;swimlaneFillColor=#FFFFFF;strokeColor=#CFD7E3;strokeWidth=2;fontFamily=Arial;fontSize=26;fontStyle=1;fontColor=#203047;align=left;spacingLeft=20;">
          <mxGeometry x="50" y="150" width="850" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="read_state" value="02  getState(electionId)" vertex="1" parent="1" style="swimlane;startSize=55;container=1;collapsible=0;pointerEvents=0;html=1;whiteSpace=wrap;fillColor=#F3F6FA;swimlaneFillColor=#FFFFFF;strokeColor=#CFD7E3;strokeWidth=2;fontFamily=Arial;fontSize=26;fontStyle=1;fontColor=#203047;align=left;spacingLeft=20;">
          <mxGeometry x="990" y="150" width="940" height="1280" as="geometry" />
        </mxCell>
        <UserObject id="create" label="&lt;b&gt;createElection(...)&lt;/b&gt;&lt;br&gt;Admin only · validate configuration" data-source="contracts/contracts/Voting.sol" data-role="process">
          <mxCell vertex="1" parent="prepare" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#203047;align=center;verticalAlign=middle;spacing=12;shadow=0;">
            <mxGeometry x="100" y="70" width="570" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="draft" label="&lt;b&gt;Draft election&lt;/b&gt;&lt;br&gt;published = false&lt;br&gt;eligibleVoterCount = totalVotes = 0" data-source="contracts/contracts/Voting.sol" data-role="process">
          <mxCell vertex="1" parent="prepare" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#203047;align=center;verticalAlign=middle;spacing=12;shadow=0;">
            <mxGeometry x="100" y="250" width="570" height="130" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="configure" label="&lt;b&gt;Configure the draft&lt;/b&gt;&lt;br&gt;Optional: updateDraft(...)&lt;br&gt;Required: setEligibility(..., true)&lt;br&gt;1–100 addresses per eligibility call" data-source="contracts/contracts/Voting.sol" data-role="process">
          <mxCell vertex="1" parent="prepare" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#203047;align=center;verticalAlign=middle;spacing=12;shadow=0;">
            <mxGeometry x="100" y="470" width="570" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="publish_call" label="&lt;b&gt;publishElection(id)&lt;/b&gt;&lt;br&gt;Creator only · unpublished draft&lt;br&gt;now &amp;lt; startsAt&lt;br&gt;eligibleVoterCount &amp;gt; 0" data-source="contracts/contracts/Voting.sol" data-role="process">
          <mxCell vertex="1" parent="prepare" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#203047;align=center;verticalAlign=middle;spacing=12;shadow=0;">
