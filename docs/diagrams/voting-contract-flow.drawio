          <mxCell vertex="1" parent="read_state" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#203047;align=center;verticalAlign=middle;spacing=12;shadow=0;">
            <mxGeometry x="80" y="70" width="300" height="150" as="geometry" />
          </mxCell>
