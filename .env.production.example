# Copy to .env.production for npm run start:sepolia.
# This is the backend RPC. A private RPC credential must stay on the server.
SEPOLIA_RPC_URL=https://sepolia.drpc.org
PORT=3002
# For a local built-app demonstration:
APP_ORIGIN=http://localhost:3002
# For hosting behind an HTTPS reverse proxy, replace the above with your domain:
# APP_ORIGIN=https://vote.example.edu
